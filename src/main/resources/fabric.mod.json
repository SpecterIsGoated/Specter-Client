{
  "schemaVersion": 1,
  "name": "Specter Client",
  "id": "specter",
  "version": "${version}",
  "description": "Specter Client: base finding, ESP, PvP, visuals and utility modules in one polished, standalone client.",
  "authors": [
    "Specter"
  ],
  "contributors": [
    "Meteor Development (MineGame159, squidoodly, seasnail) - original Meteor Client framework (GPL-3.0)"
  ],
  "contact": {
    "homepage": "https://discord.gg/UVjHt4QJwN",
    "issues": "https://discord.gg/UVjHt4QJwN"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/specter/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.jfant.specter.core.SpecterCore"
    ],
    "modmenu": [
      "com.jfant.specter.core.modintegration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "specter-core.mixins.json",
    "specter-core-baritone.mixins.json",
    "specter-core-indigo.mixins.json",
    "specter-core-sodium.mixins.json",
    "specter-core-lithium.mixins.json",
    "specter-core-metallum.mixins.json",
    "specter.mixins.json",
    "specter.compat.mixins.json",
    "specter.auto.mixins.json",
    "specter.move.mixins.json",
    "specter.move.sodium.mixins.json"
  ],
  "accessWidener": "specter.classtweaker",
  "custom": {
    "specter:build_number": "",
    "specter:color": "150,90,220",
    "specter:commit": "",
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/UVjHt4QJwN"
      }
    },
    "badoptimizations:cache_hooks": {
      "lightmap": "com.jfant.specter.core.modintegration.BadOptimizationsHook"
    }
  },
  "depends": {
    "java": ">=25",
    "minecraft": "~26.3",
    "fabricloader": ">=0.19.5"
  },
  "breaks": {
    "meteor-client": "*",
    "optifabric": "*",
    "feather": "*",
    "origins": "*",
    "sodium": "<0.9.1",
    "morechathistory": "*",
    "lithium": "<0.22.1"
  }
}
